                "kms:GenerateDataKey*",
                "kms:DescribeKey",
                "kms:CreateGrant",
              ],
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "111111111111",
                },
              },
              "Effect": "Allow",
              "Principal": {
