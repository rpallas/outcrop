{
  "name": "@rpallas/platform-cdk-runtime",
  "version": "0.1.0",
  "description": "Lambda runtime helpers for platform-cdk services: structured logging, config and secrets resolution, EventBridge envelopes and handler middleware.",
  "license": "MIT",
  "author": "Robbie Pallas",
  "repository": {
    "type": "git",
    "url": "https://github.com/rpallas/platform-cdk.git",
    "directory": "packages/platform-cdk-runtime"
  },
  "keywords": [
    "aws",
    "lambda",
    "powertools",
    "logging",
    "platform"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layer": {
      "types": "./dist/layer.d.ts",
      "default": "./dist/layer.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "layer",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-lambda-powertools/parameters": "^2.35.0",
    "@aws-sdk/client-eventbridge": "^3.1130.0",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/client-secrets-manager": "^3.1130.0",
    "@aws-sdk/client-ssm": "^3.1130.0"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
