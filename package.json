{
  "name": "outcrop-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Lambda-first AWS CDK constructs, account baseline, runtime helpers, CLI and reusable GitHub Actions workflows for building services with preview stacks.",
  "license": "MIT",
  "author": "Robbie Pallas",
  "repository": {
    "type": "git",
    "url": "https://github.com/rpallas/outcrop.git"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/outcrop-runtime",
    "packages/outcrop",
    "packages/outcrop-account",
    "packages/outcrop-neon",
    "packages/outcrop-chatops",
    "packages/outcrop-cli",
    "examples/hello-http",
    "examples/account-baseline"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean && rimraf packages/*/dist examples/*/dist",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tools/tsconfig.json",
    "test": "jest",
    "test:ci": "jest --ci",
    "test:update": "jest -u",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "denylist": "jest --selectProjects tools",
    "docs:api": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^9.39.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "aws-cdk": "^2.1141.0",
    "aws-cdk-lib": "^2.268.0",
    "cdk-nag": "^2.35.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitepress": "^1.6.4"
  }
}
